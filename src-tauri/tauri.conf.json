{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vantage",
  "version": "0.7.3",
  "identifier": "app.vantage.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Vantage",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "minWidth": 760,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFEOEQwRDUwQjk1Q0Y1NTIKUldSUzlWeTVVQTJOcmVpWEY2a2pQalNYcUhueUV6UkQvTnJhUkFkYmFBd1VGUEppemRuZ2dUZTMK",
      "endpoints": []
    }
  }
}
